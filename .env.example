# ============================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Base de datos ---
POSTGRES_USER=privapp
POSTGRES_PASSWORD=cambia_esta_contrasena_segura
POSTGRES_DB=privapp_db
DATABASE_URL=postgresql+asyncpg://privapp:cambia_esta_contrasena_segura@db:5432/privapp_db

# --- JWT ---
JWT_SECRET_KEY=genera_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Google Gemini API ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# --- Configuración general ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
