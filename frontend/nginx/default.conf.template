# Plantilla procesada por la imagen oficial de nginx al arrancar: solo sustituye
# variables de entorno definidas (PORT); $uri y similares quedan intactas.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # nginx no hereda add_header en un location que define los suyos,
    # por eso cada bloque declara sus cabeceras completas.

    # Archivos con hash en el nombre: pueden guardarse en caché indefinidamente.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Aplicación de una sola página: toda ruta desconocida la resuelve React Router.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri /index.html;
    }
}
